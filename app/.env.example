# Copy to .env. Demo mode never sends mutating requests to advertising APIs.
# Do not put NODE_ENV=development here: Vite reads this file during production builds.
# The local server defaults to development; Docker sets NODE_ENV=production.
PORT=4310
APP_ORIGIN=http://localhost:4310
DEMO_MODE=true
DATABASE_PATH=./data/ritm.sqlite
# Production PostgreSQL takes precedence over DATABASE_PATH. Render/Neon give
# this URL in their dashboard; keep it only in the host's encrypted variables.
DATABASE_URL=
# Set false only for a local, explicitly non-TLS PostgreSQL instance.
POSTGRES_SSL=true
# A stalled hosted query fails cleanly instead of holding the browser request.
POSTGRES_QUERY_TIMEOUT_MS=15000
# Set true on Render/other ephemeral containers so a missing DATABASE_URL fails
# at startup instead of silently creating a temporary SQLite database.
REQUIRE_POSTGRES=false
# Enables the deliberately limited asynchronous PostgreSQL pilot. Keep false
# until its OAuth, reporting and worker routes are covered by acceptance tests.
POSTGRES_ASYNC_PILOT=false
BACKUP_PATH=./data/backups
# Required in production: 32 random bytes in base64. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect: APP_ORIGIN/auth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# New API/debug applications use https://oauth.yandex.ru/verification_code.
# Do not configure APP_ORIGIN/auth/yandex/callback for this application type.
# Paid actions require production mode, HTTPS, a persistent encryption key and
# an explicit opt-in. Keep false during development and initial dry-runs.
LIVE_ADS_ENABLED=false
# Enables the background Budget Guard only after paid advertising itself has
# passed the live gate above. It never raises the total budget automatically.
AUTOPILOT_ENABLED=false
# Additional gate for irreversible archive and experimental A/B writes. The
# normal verified lifecycle also requires the paid-advertising gate above,
# HTTPS, a persistent encryption key and explicit confirmations.
DIRECT_WRITE_PILOT_ENABLED=false
# Separate one-time archive action. Requires stopped campaign, confirmed zero
# funds, exact campaign ID, production pilot safeguards, and an idempotency key.
DIRECT_ARCHIVE_PILOT_ENABLED=false
# Creates only variant B in an already held, verified campaign. It never sends
# ads to moderation and never resumes the campaign.
DIRECT_AB_VARIANT_PILOT_ENABLED=false
# Deletes only the verified OFF/DRAFT variant B before traffic, or suspends the
# statistically confirmed losing ad after the fixed test period. Disabled by default.
DIRECT_AB_DECISION_PILOT_ENABLED=false
# Yandex Direct retired its sandbox on 2026-07-15. Do not set
# YANDEX_SANDBOX=true. Production writes are gated as described above.
YANDEX_SANDBOX=false
# Optional read-only Python analyst. Absolute path to Python 3.10+.
PYTHON_EXECUTABLE=
# Local advertising-plan model. The app never downloads or starts Ollama itself.
# Start it separately with: ollama pull qwen3.5:4b && ollama serve
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional local advertising-photo generation. Keep false when the local worker
# is not installed; set true only together with a reachable endpoint below.
CREATIVE_IMAGES_ENABLED=false
# FastSDCPU / OpenVINO API. Use 127.0.0.1 for a host-run app and
# host.docker.internal when the Node application runs in Docker.
LOCAL_IMAGE_API_URL=http://127.0.0.1:8000
LOCAL_IMAGE_API_TOKEN=
LOCAL_IMAGE_MODEL=OpenVINO/stable-diffusion-v1-5-int8-ov
# The OpenAI API key is entered by the business owner in the Images screen.
# It is encrypted in the database and is never sent back to the browser.
# No image is requested until the owner confirms a new variant.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
# Per-business safety cap for the rolling 24-hour window (1..10).
CREATIVE_DAILY_LIMIT=3
ASSET_STORAGE_PATH=./data/creative-assets
# 0 keeps automatic removal disabled. A positive value removes only completed,
# unapproved variants older than this many days; approved assets are preserved.
CREATIVE_RETENTION_DAYS=0
# Optional external operations alert webhook. The payload contains aggregate
# readiness/queue counts only. HTTPS is required; healthy startup is silent.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_BEARER=
OPS_ALERT_INTERVAL_SECONDS=60
# Budget Guard thresholds. They affect only decisions based on fresh, exactly
# attributed Direct + Metrica data. Automatic total-budget increases are forbidden.
OPTIMIZER_MIN_CLICKS=100
OPTIMIZER_MIN_SPEND_TARGET_MULTIPLE=3
OPTIMIZER_PAUSE_CPA_TARGET_MULTIPLE=1.5
OPTIMIZER_EFFICIENT_CPA_TARGET_MULTIPLE=0.8
OPTIMIZER_MIN_GOALS_FOR_REALLOCATION=10
# How often the worker schedules source reads and how often it checks its local
# durable queues. Minimums are 60 and 5 seconds respectively.
LIVE_DATA_SCHEDULE_SECONDS=300
LIVE_DATA_TICK_SECONDS=15
